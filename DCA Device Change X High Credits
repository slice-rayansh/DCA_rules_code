spark.sql("""
with txn_around_dc as (
    SELECT 
        a.uuid,
        a.device_id,
        a.next_device_id,
        a.device_change_time,
        a.device_change_flag,
        SUM(CASE WHEN b.transactiontime < a.device_change_time THEN txn_amount END) as amount_bef_dc,
        SUM(CASE WHEN b.transactiontime >= a.device_change_time THEN txn_amount END) as amount_aft_dc,
        COUNT(CASE WHEN b.transactiontime < a.device_change_time THEN txn_amount END) as count_bef_dc,
        COUNT(CASE WHEN b.transactiontime >= a.device_change_time THEN txn_amount END) as count_aft_dc
    FROM dc_data a
    JOIN dca_txn_data b on a.uuid = b.uuid and b.transactiontime between a.device_change_time - INTERVAL '3' DAY and a.device_change_time + INTERVAL '3' DAY 
    WHERE b.txn_mode <> 'IFT - Interest Credits' and narration <> 'Payment to slice merchant QR'
    group by 1,2,3,4,5
),
dc_ordered as (
    SELECT *, row_number() over(partition by uuid order by device_change_time) as rn
    FROM txn_around_dc
)
SELECT 
    uuid,
    count(distinct device_id) as device_count,
    sum(device_change_flag) as dc_count,
    min(device_change_time) first_dc_time,
    MAX(CASE WHEN rn = 1 THEN amount_bef_dc END) as amount_bef_dc_1,
    MAX(CASE WHEN rn = 1 THEN amount_aft_dc END) as amount_aft_dc_1,
    MAX(CASE WHEN rn = 1 THEN count_bef_dc END) as count_bef_dc_1,
    MAX(CASE WHEN rn = 1 THEN count_aft_dc END) as count_aft_dc_1,
    MAX(CASE WHEN rn = 2 THEN amount_bef_dc END) as amount_bef_dc_2,
    MAX(CASE WHEN rn = 2 THEN amount_aft_dc END) as amount_aft_dc_2,
    MAX(CASE WHEN rn = 2 THEN count_bef_dc END) as count_bef_dc_2,
    MAX(CASE WHEN rn = 2 THEN count_aft_dc END) as count_aft_dc_2,
    MAX(amount_aft_dc) as max_amount_aft_dc,
    MAX_BY(amount_bef_dc, amount_aft_dc) as max_amount_bef_dc,
    MAX_BY(count_aft_dc, amount_aft_dc) as max_count_aft_dc,
    MAX_BY(count_bef_dc, amount_aft_dc) as max_count_bef_dc,
    MAX_BY(rn, amount_aft_dc) as max_amount_dc_count
FROM dc_ordered
group by 1
""").createOrReplaceTempView('dca_analysis_data')

