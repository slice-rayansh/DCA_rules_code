    # --- Reverse contact: >=1 saver (uuid_saved_by) who is MHA L1 (credit) or L1SR ---
    spark.sql(
        """
        CREATE OR REPLACE TEMP VIEW mha_l1_uuid_credit_reverse_lookup AS
        SELECT uuid AS user_id
