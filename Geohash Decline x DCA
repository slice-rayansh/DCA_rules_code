        """
    )


def register_existing_categorical_geohash_for_reason(
    spark: SparkSession, reason_key: str, view_name: str
) -> None:
    """Distinct decrypted geohash values already on type 938 with the given reason key."""
    escaped = reason_key.replace("'", "''")
    spark.sql(f"""
    CREATE OR REPLACE TEMP VIEW {view_name} AS
    SELECT DISTINCT decryptFunction(be.value) AS geohash
    FROM slice_fcu_db_gold_pii.blacklist_entry be
    INNER JOIN slice_fcu_db_gold.blacklist_type bt
        ON be.blacklisttypeid = CAST(bt.id AS INT)
    INNER JOIN slice_fcu_db_gold.blacklist_reason br
        ON CAST(bt.id AS INT) = br.blacklisttypeid
    INNER JOIN slice_fcu_db_gold.entry_reason_mapping brm
        ON CAST(be.id AS INT) = brm.blacklistentryid
        AND CAST(br.id AS INT) = brm.blacklistreasonid
    WHERE be.blacklisttypeid = {CATEGORICAL_GEOHASH_BLACKLIST_TYPE_ID}
      AND be.value IS NOT NULL
      AND COALESCE(be.__is_deleted, false) = false
      AND br.key = '{escaped}'
    """)


def discovery_columns_sql(prefix: str, categorical_exclude_view: Optional[str]) -> str:
    """User-level discovery cohort; excludes BL 572 and 938/DCAONBOARDINGDECLINE on gh5/gh6; DCA CURRENT."""
    cat_joins = ""
    cat_pred = ""
    if categorical_exclude_view:
        cat_joins = f"""
    LEFT JOIN {categorical_exclude_view} cex5 ON o.gh5 = cex5.geohash
    LEFT JOIN {categorical_exclude_view} cex6 ON o.gh6 = cex6.geohash
        """
        cat_pred = "AND cex5.geohash IS NULL AND cex6.geohash IS NULL"

    return f"""
    SELECT
        o.user_id,
        o.product_type,
        o.onboarding_date,
        o.itc_flag,
        o.current_device_id,
        o.count_of_users_on_devices,
        o.gh5,
        o.gh6,
        CASE WHEN fd.first_device_id IS NOT NULL AND o.current_device_id <> fd.first_device_id
             THEN 1 ELSE 0 END AS device_change_flag,
        COALESCE(m.l1_flag, 0) AS l1_flag,
        COALESCE(ls.l1_sr_hit, 0) AS l1_sr_flag,
        COALESCE(fz.freeze_flag, 0) AS freeze_flag
    FROM onboarding_users_geohash o
    LEFT JOIN signup_first_device_by_user fd ON o.user_id = fd.user_id
    LEFT JOIN mha_credit_flags_by_user m ON o.user_id = m.user_id
    LEFT JOIN uid_db_gold_pii.customers c ON o.user_id = c.id
    LEFT JOIN l1sr_phone_lookup ls
        ON SUBSTR(CAST(decryptFunction(c.mobile) AS STRING), -10) = ls.l1_sr_phone_num
    LEFT JOIN freeze_flag_by_user fz ON o.user_id = fz.user_id
    LEFT JOIN geo_hotspot_blacklist_{BL} g5 ON o.gh5 = g5.geohash
    LEFT JOIN geo_hotspot_blacklist_{BL} g6 ON o.gh6 = g6.geohash
    LEFT JOIN {VIEW_EXISTING_GLOBAL_ONB_DECLINE_GEOHASH} gl5 ON o.gh5 = gl5.geohash
    LEFT JOIN {VIEW_EXISTING_GLOBAL_ONB_DECLINE_GEOHASH} gl6 ON o.gh6 = gl6.geohash
    {cat_joins}
    WHERE g5.geohash IS NULL AND g6.geohash IS NULL
      AND gl5.geohash IS NULL AND gl6.geohash IS NULL
      {cat_pred}
      {prefix}
    """


def _l1_l1sr_hit_sum() -> F.Column:
    return F.sum(
        F.when((F.col("l1_flag") == 1) | (F.col("l1_sr_flag") == 1), F.lit(1)).otherwise(F.lit(0))
    )


def waterfall_bad_geohashes(df: DataFrame) -> tuple[DataFrame, DataFrame]:
    """GH6 hotspots then GH5 on remainder; returns DataFrames (no driver collect)."""
    base = df.filter(
        F.col("gh6").isNotNull()
        & (F.length(F.trim(F.col("gh6"))) > 0)
        & F.col("gh5").isNotNull()
        & (F.length(F.trim(F.col("gh5"))) > 0)
    )
    nu = F.countDistinct("user_id")
    gh6_stats = (
        base.groupBy("gh6")
        .agg(nu.alias("n_users"), _l1_l1sr_hit_sum().alias("hits"))
        .withColumn(
            "precision_l1_l1sr",
            F.when(F.col("n_users") > 0, F.col("hits") / F.col("n_users")).otherwise(F.lit(0.0)),
        )
    )
    bad6 = gh6_stats.filter(
        (F.col("n_users") >= F.lit(MIN_DISTINCT_USERS))
        & (F.col("precision_l1_l1sr") >= F.lit(MIN_PRECISION))
    ).select("gh6")
    remaining = base.join(bad6, "gh6", "left_anti")
    gh5_stats = (
        remaining.groupBy("gh5")
        .agg(nu.alias("n_users"), _l1_l1sr_hit_sum().alias("hits"))
        .withColumn(
            "precision_l1_l1sr",
            F.when(F.col("n_users") > 0, F.col("hits") / F.col("n_users")).otherwise(F.lit(0.0)),
        )
    )
    bad5 = gh5_stats.filter(
        (F.col("n_users") >= F.lit(MIN_DISTINCT_USERS))
        & (F.col("precision_l1_l1sr") >= F.lit(MIN_PRECISION))
    ).select("gh5")
    return bad6, bad5


def register_pass_actions(
    cohort_view: str, reason_key: str, existing_view: str, out_view: str
) -> None:
    """Run waterfall for one cohort and register deduped actions in a temp view."""
    bad6, bad5 = waterfall_bad_geohashes(spark.table(cohort_view))
    bad6.createOrReplaceTempView(f"{out_view}_bad6")
    bad5.createOrReplaceTempView(f"{out_view}_bad5")
    escaped_reason = reason_key.replace("'", "''")
    spark.sql(
        f"""
        CREATE OR REPLACE TEMP VIEW {out_view} AS
        SELECT DISTINCT blacklist_entry_value, blacklist_reason_key, geohash_precision
        FROM (
            SELECT
                b.gh6 AS blacklist_entry_value,
                '{escaped_reason}' AS blacklist_reason_key,
                'gh6' AS geohash_precision
            FROM {out_view}_bad6 b
            LEFT ANTI JOIN {existing_view} e ON b.gh6 = e.geohash
            WHERE b.gh6 IS NOT NULL AND LENGTH(TRIM(b.gh6)) > 0
            UNION ALL
            SELECT
                b.gh5 AS blacklist_entry_value,
                '{escaped_reason}' AS blacklist_reason_key,
                'gh5' AS geohash_precision
            FROM {out_view}_bad5 b
            LEFT ANTI JOIN {existing_view} e ON b.gh5 = e.geohash
            WHERE b.gh5 IS NOT NULL AND LENGTH(TRIM(b.gh5)) > 0
        ) actions
        """
    )
    logger.info("Registered %s for reason %s", out_view, reason_key)


def geohash_summary(
    spark: SparkSession,
    df_view: str,
    gh6_list: list[str],
    gh5_list: list[str],
):
    df = spark.table(df_view)

    hit = F.when(
        (F.col("l1_flag") == 1) | (F.col("l1_sr_flag") == 1),
        1,
    ).otherwise(0)

    summaries = []

    # GH6 summaries
    if gh6_list:
        gh6_summary = (
            df.filter(F.col("gh6").isin(gh6_list))
            .groupBy("gh6")
            .agg(
                F.countDistinct("user_id").alias("total_users"),
                F.sum(hit).alias("fraud_cases"),
            )
            .withColumn(
                "precision",
                F.round(F.col("fraud_cases") / F.col("total_users"), 4),
            )
            .withColumn("geohash_precision", F.lit("gh6"))
            .withColumnRenamed("gh6", "geohash")
        )

        summaries.append(gh6_summary)

    # GH5 summaries
    if gh5_list:
        remaining = df
        if gh6_list:
            remaining = remaining.filter(~F.col("gh6").isin(gh6_list))

        gh5_summary = (
            remaining.filter(F.col("gh5").isin(gh5_list))
            .groupBy("gh5")
            .agg(
                F.countDistinct("user_id").alias("total_users"),
                F.sum(hit).alias("fraud_cases"),
            )
            .withColumn(
                "precision",
                F.round(F.col("fraud_cases") / F.col("total_users"), 4),
            )
            .withColumn("geohash_precision", F.lit("gh5"))
            .withColumnRenamed("gh5", "geohash")
        )

        summaries.append(gh5_summary)

    if not summaries:
        return None

    final_df = summaries[0]
    for s in summaries[1:]:
        final_df = final_df.unionByName(s)

    return final_df.orderBy(F.desc("fraud_cases"), F.desc("total_users"))


def blacklist_geohashes(geohashes: Iterable[str], reason_key: str) -> tuple[int, int]:
    """
    POST each geohash to fraud-control blacklist create with CATEGORICALGEOHASH and the given reason.
    One HTTP call per geohash (same reason for the batch).
    """
    url = "https://api.nebank.com/banking/fraud-control-go/v1/blacklist/v1/create"
    headers = {"Content-Type": "application/json"}

    success_count = 0
    failure_count = 0
    items = list(geohashes)
    logger.info("Starting blacklisting for %s geohashes (reason=%s)...", len(items), reason_key)

    for geohash in items:
        entity = {
            "blacklistTypeKey": "CATEGORICALGEOHASH",
            "blacklistEntryValue": geohash,
            "blacklistEntryReasonMapping": {reason_key: 1},
        }
        try:
            logger.info("Blacklisting geohash: %s reason=%s", geohash, reason_key)
            response = requests.post(url, headers=headers, json=entity, timeout=30)
            if response.status_code == 200:
                logger.info("Successfully blacklisted %s", geohash)
                success_count += 1
            else:
                logger.error(
                    "Failed to blacklist %s. Status=%s Response=%s",
                    geohash,
                    response.status_code,
                    response.text,
                )
                failure_count += 1
        except Exception as e:
            logger.error("Exception while blacklisting %s: %s", geohash, e, exc_info=True)
            failure_count += 1

    logger.info("Blacklisting summary reason=%s: success=%s failure=%s", reason_key, success_count, failure_count)
    return success_count, failure_count


