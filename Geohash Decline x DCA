        FROM slice_fcu_db_gold.onboarding_variables a
        JOIN druid_gold.user_savings_details b
            ON a.uuid = b.user_id
        INNER JOIN dca_users du ON du.user_id = a.uuid
        WHERE COALESCE(a.__is_deleted, false) = false
          AND COALESCE(b.__is_deleted, false) = false
          AND b.account_type = 'CURRENT'
          AND a.geohash6 IS NOT NULL
          AND LENGTH(TRIM(a.geohash6)) >= 5
          AND a.geohash6 <> 's00000'
          AND a.current_stage = 'VKYC_COMPLETED'
    ) t
    WHERE rn = 1
    """)

    spark.sql("""
    CREATE OR REPLACE TEMP VIEW signup_first_device_by_user AS
    SELECT customer_id AS user_id, device_id AS first_device_id
    FROM (
        SELECT customer_id, device_id,
