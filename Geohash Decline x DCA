        """
        CREATE OR REPLACE TEMP VIEW dca_users AS
        SELECT user_id, customer_id, account_no
        FROM (
            SELECT
                d.user_id,
                ca.customer_id,
                CAST(ca.account_no AS STRING) AS account_no,
                ROW_NUMBER() OVER (
                    PARTITION BY d.user_id
                    ORDER BY COALESCE(am.account_open_date, am.created_date) ASC, am.account_id ASC
                ) AS rn
            FROM druid_gold.user_savings_details d
            JOIN bsgcore_gold.customer_accounts ca
                ON CAST(ca.account_no AS STRING) = CAST(d.account_number AS STRING)
            JOIN bsgcore_gold.account_master am
                ON am.account_id = ca.account_id
                AND am.is_active = 1
                AND COALESCE(am.__is_deleted, FALSE) = FALSE
                AND am.product_code = 1150
            WHERE COALESCE(d.__is_deleted, FALSE) = FALSE
              AND COALESCE(ca.__is_deleted, FALSE) = FALSE
              AND ca.is_active = 1
              AND d.account_type = 'CURRENT'
        ) z
        WHERE rn = 1
        """
    )

    spark.sql("""
    CREATE OR REPLACE TEMP VIEW onboarding_users_geohash AS
    SELECT *
    FROM (
        SELECT
            a.uuid AS user_id,
            product_type,
            date(b.onboarding_date) as onboarding_date,
