            "AND o.user_id IN (SELECT user_id FROM dca_reverse_contact_l1_l1sr_users)",
            VIEW_EXISTING_R3,
        ),
        REASON_PASS3,
        VIEW_EXISTING_R3,
        "actions_pass3",
    ),
]

for cohort_view, cohort_sql, reason_key, existing_view, actions_view in COHORT_SPECS:
    spark.sql(f"CREATE OR REPLACE TEMP VIEW {cohort_view} AS {cohort_sql}")
    try:
        spark.catalog.cacheTable(cohort_view)
    except Exception as e:
        logger.warning("Could not cache %s (%s); continuing.", cohort_view, e)
    logger.info("Running pass %s (%s)", reason_key, cohort_view)
    register_pass_actions(cohort_view, reason_key, existing_view, actions_view)
    try:
        spark.catalog.uncacheTable(cohort_view)
    except Exception:
        pass

spark.sql(
    """
    CREATE OR REPLACE TEMP VIEW to_action_dedup AS
    SELECT DISTINCT blacklist_entry_value, blacklist_reason_key, geohash_precision
    FROM (
        SELECT * FROM actions_pass1
        UNION ALL
        SELECT * FROM actions_pass2
        UNION ALL
        SELECT * FROM actions_pass3
    ) all_actions
    """
)

to_action_dedup = spark.table("to_action_dedup").persist(StorageLevel.MEMORY_AND_DISK)

out_base = OUTPUT_PATH.rstrip("/")
logger.info("Writing action rows to %s/all_segments/", out_base)
to_action_dedup.write.mode("append").parquet(f"{out_base}/all_segments/")

for reason_key, subdir in (
    (REASON_PASS1, "multiuserdevice"),
    (REASON_PASS2, "udyamsamedayonboarding"),
    (REASON_PASS3, "l1rcvkycreview"),
):
    reason_df = to_action_dedup.filter(F.col("blacklist_reason_key") == reason_key)
    if not reason_df.head(1):
        continue
    reason_df.write.mode("append").parquet(f"{out_base}/{subdir}/")

logger.info("Planned blacklist API calls (after existing filter per reason)")
for row in to_action_dedup.orderBy("blacklist_reason_key", "blacklist_entry_value").limit(50).toLocalIterator():
    logger.info("  %s  %s", row["blacklist_reason_key"], row["blacklist_entry_value"])

total_ok = total_fail = 0
api_action_count = 0
for reason_key in (REASON_PASS1, REASON_PASS2, REASON_PASS3):
    reason_geohashes = [
        row["blacklist_entry_value"]
        for row in to_action_dedup.filter(F.col("blacklist_reason_key") == reason_key)
        .select("blacklist_entry_value")
        .distinct()
        .toLocalIterator()
    ]
    if not reason_geohashes:
        continue
    api_action_count += len(reason_geohashes)
    ok, fail = blacklist_geohashes(reason_geohashes, reason_key)
    total_ok += ok
    total_fail += fail

logger.info("All reasons done: api_calls=%s success=%s failure=%s", api_action_count, total_ok, total_fail)

try:
    to_action_dedup.unpersist()
except Exception:
    pass
