    spark.sql(
        """
        CREATE OR REPLACE TEMP VIEW dca_udyam_registration_date_hyperverge AS
        SELECT
            u.user_id,
            DATE(CAST(h.date_of_udyam_registration AS TIMESTAMP)) AS udyam_registration_date
        FROM dca_users u
        INNER JOIN (
            SELECT
                uuid,
