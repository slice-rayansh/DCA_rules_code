        (
            spark.read.parquet(L1SR_PARQUET)
            .filter(F.lower(F.col("filename")).like("%layer1%"))
            .select(F.expr("right(cast(phone_number as string), 10)").alias("l1_sr_phone_num"))
            .withColumn("l1_sr_hit", F.lit(1))
            .distinct()
            .createOrReplaceTempView("l1sr_phone_lookup")
        )
    except Exception as e:
        logger.warning("L1 SR parquet not loaded (%s); l1_sr_flag will be 0.", e)
        spark.sql(
            "CREATE OR REPLACE TEMP VIEW l1sr_phone_lookup AS "
            "SELECT CAST(NULL AS STRING) AS l1_sr_phone_num, 0 AS l1_sr_hit WHERE 1=0"
